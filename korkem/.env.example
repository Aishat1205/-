# Серверная переменная — НЕ попадает в клиентский код.
# Нужна только для AI-генерации сказок (необязательно).
ANTHROPIC_API_KEY=
# Модель для генерации (необязательно)
STORY_MODEL=claude-opus-5-5

# ——— Живой (нейросетевой) голос — необязательно, достаточно одного провайдера ———
